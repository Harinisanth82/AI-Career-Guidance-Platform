# EmployabilityAI — Canonical Environment Example

# Backend Environment Variables (stored in backend/.env)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/career_guidance?retryWrites=true&w=majority
DATABASE_NAME=career_guidance
DATABASE_URL=sqlite:///./career_guidance.db
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000

# Google Gemini API Key (Server-Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend Environment Variables (proxied via Vite)
VITE_API_BASE_URL=/api
