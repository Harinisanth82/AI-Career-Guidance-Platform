# MongoDB Atlas or Local Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/career_guidance?retryWrites=true&w=majority
DATABASE_NAME=career_guidance

# Local development default. In production, configure DATABASE_URL as
# postgresql+psycopg://user:password@host:5432/database (managed PostgreSQL).
DATABASE_URL=sqlite:///./career_guidance.db

# JWT Security
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Port
PORT=8000

# Google Gemini API Configuration (Server-Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
